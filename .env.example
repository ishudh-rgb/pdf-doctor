# =============================================================================
# OnlyMyPDF — environment variables (copy to .env.local; never commit real values)
# =============================================================================

# --- Public (exposed to the browser via NEXT_PUBLIC_*) ---
# Safe only when noted. Restrict API keys in Google Cloud / Dropbox consoles.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OnlyMyPDF
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# Anon key is client-safe ONLY when Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Razorpay publishable key (checkout UI) — secret key stays server-side only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# Google Drive picker — restrict key by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key
NEXT_PUBLIC_DROPBOX_APP_KEY=your_dropbox_app_key
NEXT_PUBLIC_CLIENT_PDF_TOOLS=true
# NEXT_PUBLIC_MAX_FREE_FILE_SIZE_MB=25
# NEXT_PUBLIC_MAX_PRO_FILE_SIZE_MB=200
# NEXT_PUBLIC_BRAND_LOGO=/logo.png
# NEXT_PUBLIC_BRAND_LOGO_ICON=/logo-icon.png
# NEXT_PUBLIC_BRAND_LOGO_SHOW_TEXT=true
# NEXT_PUBLIC_STATUS_PAGE_URL=https://status.onlymypdf.com
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_DESIGN_PREVIEW=false
# NEXT_PUBLIC_BILLING_MODE=mock

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CRON_SECRET=your_random_secret_here
# Used for local-dev auth when Supabase is not configured (dev only).
LOCAL_DEV_SESSION_SECRET=your_local_dev_session_secret
IP_HASH_SALT=change_me_in_production
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=OnlyMyPDF <onboarding@resend.dev>
CONTACT_INBOX_EMAIL=support@onlymypdf.in
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
# Required in production (rate limits + PDF→Word job queue)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
SENTRY_DSN=your_sentry_dsn
# Optional but recommended on Vercel for PDF→Word
CONVERTAPI_SECRET=your_convertapi_secret

# --- Billing (Razorpay — no Stripe in this project) ---
# mock = dev/local only (blocked in production). live = real checkout + webhook.
BILLING_MODE=mock
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Required when BILLING_MODE=live (Razorpay dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_xxxxx
# RAZORPAY_PRO_YEARLY_PLAN_ID=plan_xxxxx
# BILLING_GSTIN=22AAAAA0000A1Z5
# BILLING_LEGAL_NAME=Your Legal Entity Name
# BILLING_GST_RATE=18

# --- App limits ---
MAX_FREE_FILE_SIZE_MB=25
MAX_PRO_FILE_SIZE_MB=200
FILE_RETENTION_HOURS=2
MAX_CONCURRENT_HEAVY_JOBS=2
MAX_UPLOAD_BODY_MB=110
ADMIN_EMAIL=admin@pdfdoctor.com

# --- Optional Sentry upload (CI / source maps) ---
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Optional local conversion tooling ---
# PDF2DOCX_PYTHON=C:\Users\You\AppData\Local\Programs\Python\Python312\python.exe
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
